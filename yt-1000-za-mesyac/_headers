# Заголовки Cloudflare Pages. Правила для одного пути складываются — не пересекайте Cache-Control.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP: скрипты только свои и Meta Pixel (assets/js/pixel.js), видео только Bunny/YouTube, сайт нельзя встроить в чужой iframe
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://connect.facebook.net https://www.facebook.com https://*.b-cdn.net https://script.google.com https://script.googleusercontent.com; frame-src https://*.mediadelivery.net https://www.youtube-nocookie.com https://www.facebook.com; media-src 'self' blob: https://*.b-cdn.net; object-src 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# CSS/JS в HTML с ?v=<хеш>, библиотеки и шрифты не меняются — кэш на год
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
